/datum/faith/tribunal
	name = "The Tribunal"
	desc = "   </br>''Before the Six Seats, there was the Word.'' </br>  \
		</br>Praecursor spoke the first law and fell silent after binding the Unmaker with the Comet Syon. Vergenmark's Ordo Iusta \
		once ruled the whole of Auxentia's north in his name before a schism folded most of it under the Concordat's Court instead - \
		what remains is a doctrinal enclave still bound to strict hierarchy: Praecursor's Word above all, Custodius's law enforcing \
		it, Verita's truth binding every oath and contract sworn within its valleys. </br>  \
		</br>The Tribunal's faithful believe the Word does not bend, whatever the Compact's Six Seats might tolerate on the plains \
		below. If those of the Unveiled refuse to recant, then correction must follow - and a harsher fringe answering to no seat but \
		its own conviction, the Inquisition, grows from that same conviction unchecked."
	worshippers = "Magistrates, Zealots, Inquisitors, Witnesses, and the Hopeful"
	godhead = /datum/patron/tribunal/praecursor
