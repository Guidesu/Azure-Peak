/datum/faith/severance
	name = "The Severance"
	desc = "Ignatius and Kamenka, one god remembering itself as two since something - no two accounts agree what - tore them apart \
		and split Dvojezem in half between them. \n\
		Ognica keeps to Ignatius's inheritance of growth, change, risk, and fire; Kamenrad keeps to Kamenka's inheritance of stillness, \
		preservation, duty, and stone. Most who follow the Severance venerate both across a lifetime rather than choosing, and shrines \
		here are raised in pairs - one face lit for Ignatius, one left dark for Kamenka."
	worshippers = "Settlers, Risk-Takers, Masons, Elders, and the Dutiful"
	godhead = /datum/patron/severance/ignatius
