/datum/faith/unveiled
	name = "The Unveiled"
	desc = "Aurelian's claim runs simple and dangerous: no priesthood should stand between a soul and the divine, and every older \
		god's guarded domain is a lie told to keep the faithful paying tithes. \n\
		The Unveiled are strongest in Via Medulla's free cities, where no single crown or Seat holds sway, and are split between the \
		gentle 'Plainfolk' majority - content to simply worship without clergy - and the violent 'Stripping' minority, which actively \
		unmakes the shrines of older gods within the cities it wins over. \
		To the Concordat and Tribunal alike, this is rank heresy. To a growing number of Medullans, it's just an honest religion for \
		a world that already answers to no one god or king."
	worshippers = "Free-City Heretics, Apostates, Necromancers, and the Plainfolk"
	godhead = /datum/patron/unveiled/aurelian
	preference_accessible = TRUE
