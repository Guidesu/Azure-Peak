/datum/faith/concordat
	name = "The Concordat"
	desc = "The Court of Six Seats, civic and orthodox, governs in the name of its six gods under the Vaeltis Compact - Auxentius of law \
		and kingship foremost among equals, but never above the other five. \n \n\
		The Concordat holds most of Auxentia and much of the settled world, its Six Seats keeping an uneasy balance between the sun's \
		law, the moon's tide, the hearth's fury, the ledger's due, the road's fortune, and the maker's hand. \
		A harsher splinter, the Ordo Iusta of Vergenmark, broke away to worship the Tribunal instead, believing the Concordat's balance \
		a compromise with heresy. But it is through the Concordat's Six that most of Vaeltis still keeps its oaths."
	worshippers = "Commonfolk, the Faithful, Magistrates, and the Denizens of the Compact"
	godhead = /datum/patron/concordat/auxentius
