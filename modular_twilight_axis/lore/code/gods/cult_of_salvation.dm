/datum/faith/cult_of_salvation
	name = "The Cult of Salvation"
	translated_name = "The Cult of Salvation"
	desc = "The cultists of the Bearer of Salvation reject the world order as we know it, and follow the dark, bloody light of Zizo.\n\
		The ideas of the teaching that the Zizoids follow are rooted deeply in the history of this world, shrouded in a dark veil of secrets and mysteries. But they converge on one thing. This world is yours. Here there are no shackles, no rules, no morality, and no boundaries. You are free to create around you what you desire yourself; you need only courage, desire, and the knowledge of how to achieve it."
	worshippers = "Those who seek forbidden knowledge; those who are shunned by others; those who desperately fear death."
	godhead = /datum/patron/inhumen/zizo
